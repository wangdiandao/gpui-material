---
import { pagePath } from './site.mjs';

const { lang, story, title } = Astro.props;
const query = new URLSearchParams({ story, lang });
const src = `${pagePath('demo', 'en')}?${query}`;
---
<div class="gallery-preview" data-pagefind-ignore>
  <iframe title={title + ' · Rust / WebAssembly'} {src} loading="lazy"></iframe>
</div>
