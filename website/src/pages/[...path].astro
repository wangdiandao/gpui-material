---
import { Code } from 'astro:components';
import Layout from '../Layout.astro';
import Home from '../Home.astro';
import NavigationList from '../NavigationList.astro';
import Preview from '../Preview.astro';
import { components } from '../../component/catalog.mjs';
import { api, copy, groups, guides, packageVersion, pagePath, sidebar } from '../site.mjs';
import { repository } from '../markdown.mjs';

export function getStaticPaths() {
  const pages = ['', 'component', 'gallery', ...components.map((item) => `component/${item.slug}`)];
  return [
    ...guides.map((guide) => ({
      params: { path: guide.route },
      props: { guide },
    })),
    ...pages.flatMap((route) => [
      { params: { path: route || undefined } },
      { params: { path: ['zh-CN', route].filter(Boolean).join('/') } },
    ]),
  ];
}

const path = Astro.params.path ?? '';
const lang = path === 'zh-CN' || path.startsWith('zh-CN/') ? 'zh' : 'en';
const route = path.replace(/^zh-CN(?:\/|$)/, '');
const t = copy[lang];
const { guide } = Astro.props;
const component = components.find((item) => route === `component/${item.slug}`);
const headings = guide ? await guide.module.getHeadings() : [];
const Content = guide?.module.Content;
const isHome = route === '';
const isCatalog = route === 'component';
const isGallery = route === 'gallery';
const hasPreview = ['button', 'checkbox', 'dialog', 'progress', 'radio', 'slider', 'switch', 'text-field'].includes(component?.slug);
const componentSections = component ? [
  ...(component.feature ? [{ slug: 'cargo-feature', text: t.feature }] : []),
  ...(hasPreview ? [{ slug: 'browser-preview', text: t.preview }] : []),
  { slug: 'usage', text: t.usage },
  ...(component.story ? [{ slug: 'native-gallery', text: t.nativeGallery }] : []),
] : [];
const toc = isCatalog
  ? Object.entries(groups).map(([slug, label]) => ({ slug, text: label[lang], depth: 2 }))
  : component ? componentSections : headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const title = component?.title ?? headings[0]?.text ?? (isCatalog ? t.overview : isGallery ? t.nativeGallery : '');
const codeThemes = { light: 'github-light', dark: 'github-dark' };
const featureCode = component?.feature ? `[dependencies]\ngpui-material = { version = "${packageVersion}", features = ["${component.feature}"] }` : '';
const componentApi = component?.feature
  ? `https://docs.rs/crate/gpui-material/latest/features#${component.feature}`
  : api + (component?.api ?? '');
const source = component ? `${repository}/blob/main/${component.source}` : '';
const introCode = 'git clone https://github.com/wangdiandao/gpui-material.git\ncd gpui-material\ncargo gallery';
---
<Layout {lang} {route} {title} description={component?.description[lang]}>
  {isHome ? (
    <Home {lang} {codeThemes} />
  ) : (
    <div class="docs-shell">
      <aside class="sidebar" data-pagefind-ignore>
        <NavigationList label={t.menu} sections={sidebar(lang, route.split('/')[0])} {route} {lang} />
      </aside>
      <main id="main" class="article" data-pagefind-body>
        {Content && <Content />}
        {isCatalog && <>
          <h1>{title}</h1>
          <p class="lede">{t.catalogIntro}</p>
          {Object.entries(groups).map(([group, label]) => (
            <section class="component-family" aria-labelledby={group}>
              <h2 id={group}>{label[lang]}</h2>
              <div class="component-grid">
                {components.filter((item) => item.group === group).map((item) => (
                  <mdui-card class="component-card" variant="outlined" href={pagePath(`component/${item.slug}`, lang)}>
                    <strong>{item.title}</strong>
                    <span>{item.description[lang]}</span>
                  </mdui-card>
                ))}
              </div>
            </section>
          ))}
        </>}
        {component && <>
          <p class="breadcrumb"><a href={pagePath('component', lang)}>{t.overview}</a> <span aria-hidden="true">/</span> {groups[component.group][lang]}</p>
          <h1>{title}</h1>
          <p class="lede">{component.description[lang]}</p>
          <div class="article-links">
            <mdui-button variant="tonal" href={componentApi}>{component.feature ? t.feature : t.api} <span slot="end-icon" aria-hidden="true">↗</span></mdui-button>
            <mdui-button variant="outlined" href={source}>{t.source} <span slot="end-icon" aria-hidden="true">↗</span></mdui-button>
            {component.story && <mdui-button variant="text" href="#native-gallery">{t.nativeGallery}</mdui-button>}
          </div>
          {component.feature && <>
            <h2 id="cargo-feature">{t.feature}</h2>
            <Code code={featureCode} lang="toml" themes={codeThemes} />
          </>}
          {hasPreview && <>
            <h2 id="browser-preview">{t.preview}</h2>
            <mdui-card class="preview-card" variant="filled">
              <p>{t.previewNote}</p>
              <Preview {lang} kind={component.slug} />
            </mdui-card>
          </>}
          <h2 id="usage">{t.usage}</h2>
          <p>{component.usage[lang]}</p>
          <Code code={component.code} lang="rust" themes={codeThemes} />
          {component.story && <>
            <h2 id="native-gallery">{t.nativeGallery}</h2>
            <p>{t.sourceOnly}</p>
            <Code code={[component.story, component.relatedStory].filter(Boolean).map((id) => `cargo gallery ${id}`).join('\n')} lang="sh" themes={codeThemes} />
          </>}
        </>}
        {isGallery && <>
          <h1>{title}</h1>
          <p class="lede">{t.galleryIntro}</p>
          <Code code={introCode} lang="sh" themes={codeThemes} />
          <p>{t.galleryOpen}</p>
          <Code code="cargo gallery text-field" lang="sh" themes={codeThemes} />
          <div class="article-links">
            <mdui-button variant="tonal" href={pagePath('component', lang)}>{t.overview}</mdui-button>
            <mdui-button variant="outlined" href={`${repository}/tree/main/apps/gallery`}>{t.source}</mdui-button>
          </div>
        </>}
      </main>
      {toc.length > 0 && (
        <aside class="toc" data-pagefind-ignore>
          <nav aria-label={t.onThisPage}>
            <p>{t.onThisPage}</p>
            {toc.map(({ slug, text, depth }) => <a href={`#${slug}`} class:list={{ nested: depth === 3 }}>{text}</a>)}
          </nav>
        </aside>
      )}
    </div>
  )}
</Layout>
