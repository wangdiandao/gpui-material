---
import { copy, pagePath, pageTitle } from '../site.mjs';

const root = pagePath('', 'en');
const bindings = root + 'wasm/material-gallery.js';
---
<!doctype html>
<html lang="en" data-title-zh={pageTitle(copy.zh.componentPreview)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle(copy.en.componentPreview)}</title>
    <link rel="icon" type="image/svg+xml" href={root + 'favicon.svg'} />
  </head>
  <body data-bindings={bindings} data-state="loading">
    <p id="status" role="status">Loading the component preview…</p>
    <script>
      const params = new URLSearchParams(location.search);
      const zh = params.get('lang') === 'zh';
      const story = params.get('story');
      const status = document.querySelector<HTMLParagraphElement>('#status')!;
      const preference = matchMedia('(prefers-color-scheme: dark)');
      const embedded = window.parent !== window;
      let hostTheme = document.documentElement;
      if (embedded) {
        try { hostTheme = window.parent.document.documentElement; } catch {}
      }
      const isDark = () => hostTheme.classList.contains('mdui-theme-dark')
        || (!hostTheme.classList.contains('mdui-theme-light') && preference.matches);

      document.documentElement.lang = zh ? 'zh-CN' : 'en';
      if (zh) document.title = document.documentElement.dataset.titleZh!;
      status.textContent = zh ? '正在加载组件预览…' : 'Loading the component preview…';
      document.documentElement.classList.toggle('dark', isDark());

      let usedPointer = false;
      window.addEventListener('pointerdown', () => { usedPointer = true; }, { capture: true, once: true });

      const showFailure = (error: unknown) => {
        console.error('Component preview failed to start', error);
        document.body.dataset.state = 'failed';
        status.textContent = zh
          ? '无法启动组件预览。请使用支持 WebGPU 或 WebGL2 的浏览器。'
          : 'The component preview could not start. Use a browser with WebGPU or WebGL2.';
      };

      async function start() {
        if (!story) {
          document.body.dataset.state = 'failed';
          status.textContent = zh ? '请从组件文档打开预览。' : 'Open a preview from a component guide.';
          return;
        }
        try {
          const wasm = await import(/* @vite-ignore */ document.body.dataset.bindings!);
          await wasm.default();
          let dark = isDark();
          const syncTheme = () => {
            const next = isDark();
            if (next === dark) return;
            dark = next;
            document.documentElement.classList.toggle('dark', dark);
            wasm.set_theme(dark);
          };
          const timeout = window.setTimeout(() => showFailure('No frame started'), 20_000);
          try {
            wasm.run(story, dark, (error?: string) => queueMicrotask(() => {
              window.clearTimeout(timeout);
              if (error) {
                showFailure(error);
                return;
              }
              document.body.dataset.state = 'ready';
              // Opening an iframe must not move focus away from the guide.
              if (embedded && !usedPointer && document.activeElement instanceof HTMLElement) {
                document.activeElement.blur();
              }
              new MutationObserver(syncTheme).observe(hostTheme, { attributes: true, attributeFilter: ['class'] });
              preference.addEventListener('change', syncTheme);
              syncTheme();
            }));
          } catch (error) {
            window.clearTimeout(timeout);
            throw error;
          }
        } catch (error) {
          showFailure(error);
        }
      }
      void start();
    </script>
  </body>
</html>

<style is:global>
  /* Give the GPUI canvas the iframe viewport and keep scroll offsets in GPUI. */
  html, body { height: 100%; overflow: hidden; }
  html { color-scheme: light; }
  html.dark { color-scheme: dark; }
  body { margin: 0; background: Canvas; color: CanvasText; font: 1rem/1.5 system-ui, sans-serif; }
  #status {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 1rem;
    background: Canvas;
    text-align: center;
  }
  [data-state="ready"] #status { display: none; }
</style>
